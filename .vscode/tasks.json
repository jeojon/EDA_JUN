{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 构建 EDA",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用项目现有 build 目录进行 CMake 构建"
        }
    ]
}
